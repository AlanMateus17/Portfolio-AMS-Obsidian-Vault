{
  "text": "<style>\n.pf { display: grid; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n.pf-cab { display: grid; gap: var(--cds-gap-xs); }\n.pf-titulo { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; }\n.pf-resumo { color: var(--color-fg-muted); margin: 0; }\n.pf-tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--cds-gap-md); }\n.pf-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: grid; gap: var(--cds-gap-xs); align-content: start; min-width: 0; }\n.pf-rot { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n.pf-num { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); font-variant-numeric: tabular-nums; }\n.pf-sub { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); font-variant-numeric: tabular-nums; }\n.pf-grade { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: var(--cds-gap-md); }\n.pf-h { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n.pf-nota { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); margin: 0; }\n.pf-graf { position: relative; min-height: 240px; }\n.pf-tip { position: absolute; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); pointer-events: none; white-space: nowrap; font-variant-numeric: tabular-nums; }\n.pf-tip .d { color: var(--cds-text-secondary); }\n.pf-tabwrap { max-height: 26rem; overflow: auto; }\n.pf-tab { width: 100%; border-collapse: collapse; font-size: var(--cds-font-size-body); font-variant-numeric: tabular-nums; }\n.pf-tab th { position: sticky; top: 0; background: var(--color-panel); text-align: right; font-weight: var(--cds-font-weight-medium); font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); }\n.pf-tab td { text-align: right; padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n.pf-tab th:first-child, .pf-tab td:first-child { text-align: left; }\n.pf-falta { margin: 0; padding-left: 1.2rem; display: grid; gap: var(--cds-gap-xs); }\n.pf-up { color: var(--color-ok); } .pf-down { color: var(--color-bad); }\n[data-dash-source-state=empty] { color: transparent; }\n[data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n.pf-erro { display: flex; align-items: center; justify-content: center; gap: var(--cds-gap-xs); min-height: 240px; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); }\n.pf-erro i { width: .375rem; height: .375rem; border-radius: 50%; background: var(--color-bad); display: inline-block; }\n</style>\n\n<div class=\"pf\">\n  <header class=\"pf-cab\">\n    <h1 class=\"pf-titulo\" id=\"topo\">Meu progresso financeiro</h1>\n    <p class=\"pf-resumo\" id=\"resumo\">No último mês (<span class=\"dash-skeleton\" data-source=\"resumo\" data-field=\"ultimo_mes\">—</span>) você recebeu <span class=\"dash-skeleton\" data-source=\"resumo\" data-field=\"ultimo_liquido\">—</span> líquidos do Estado, <span class=\"dash-skeleton\" data-source=\"resumo\" data-field=\"pct_meta\">—</span> da meta de R$ 7.000/mês.</p>\n  </header>\n\n  <section class=\"pf-tiles\" id=\"numeros\">\n    <div class=\"pf-card\">\n      <span class=\"pf-rot\">Total líquido recebido · mar/2025 até hoje</span>\n      <span class=\"pf-num dash-skeleton\" data-source=\"resumo\" data-field=\"total_liquido\">—</span>\n      <span class=\"pf-sub\">em <span data-source=\"resumo\" data-field=\"meses\">—</span> meses</span>\n    </div>\n    <div class=\"pf-card\">\n      <span class=\"pf-rot\">Média líquida · últimos 3 meses</span>\n      <span class=\"pf-num dash-skeleton\" data-source=\"resumo\" data-field=\"media_3m\">—</span>\n      <span class=\"pf-sub\">Primeiros 3 meses: <span data-source=\"resumo\" data-field=\"media_inicio\">—</span></span>\n    </div>\n    <div class=\"pf-card\">\n      <span class=\"pf-rot\">Falta para a meta de R$ 7.000 · último mês</span>\n      <span class=\"pf-num dash-skeleton\" data-source=\"resumo\" data-field=\"falta_meta\">—</span>\n      <span class=\"pf-sub\">por mês, a cobrir com outras rendas</span>\n    </div>\n    <div class=\"pf-card\">\n      <span class=\"pf-rot\">Descontos no contracheque · total</span>\n      <span class=\"pf-num dash-skeleton\" data-source=\"resumo\" data-field=\"total_descontos\">—</span>\n      <span class=\"pf-sub\">de <span data-source=\"resumo\" data-field=\"total_bruto\">—</span> brutos</span>\n    </div>\n  </section>\n\n  <section class=\"pf-grade\">\n    <div class=\"pf-card\">\n      <h2 class=\"pf-h\" id=\"por-mes\">Renda líquida por mês</h2>\n      <p class=\"pf-nota\">Mês em que o dinheiro caiu na conta, somando os dois vínculos. A linha tracejada é a meta de R$ 7.000.</p>\n      <div class=\"pf-graf\" id=\"g-mensal\" data-source=\"mensal\"></div>\n    </div>\n    <div class=\"pf-card\">\n      <h2 class=\"pf-h\" id=\"acumulado\">Quanto já entrou, acumulado</h2>\n      <p class=\"pf-nota\">Soma de tudo que você recebeu líquido desde março de 2025.</p>\n      <div class=\"pf-graf\" id=\"g-acum\" data-source=\"mensal\"></div>\n    </div>\n  </section>\n\n  <section class=\"pf-card\">\n    <h2 class=\"pf-h\" id=\"tabela\">Mês a mês</h2>\n    <p class=\"pf-nota\">Bruto, descontos (INSS, IR e outros) e líquido de cada mês de recebimento.</p>\n    <div class=\"pf-tabwrap\">\n      <table class=\"pf-tab\" data-source=\"mensal\" data-row-key=\"mes\">\n        <thead><tr>\n          <th data-field=\"mes\">Mês</th>\n          <th data-field=\"bruto\">Bruto</th>\n          <th data-field=\"descontos\">Descontos</th>\n          <th data-field=\"liquido\">Líquido</th>\n          <th data-field=\"acumulado\">Acumulado</th>\n        </tr></thead>\n        <tbody></tbody>\n      </table>\n    </div>\n  </section>\n\n  <section class=\"pf-card\">\n    <h2 class=\"pf-h\" id=\"falta\">O que este painel ainda não mostra</h2>\n    <p class=\"pf-nota\">O Caixa da Casa 2 só tem seus contracheques do Estado lançados. Para mostrar progresso de verdade (quanto sobrou, não só quanto entrou), faltam:</p>\n    <ul class=\"pf-falta\">\n      <li>Despesas: as contas fixas (consórcio, ajuda à sua mãe, faculdade, internet etc.) e os gastos do dia a dia.</li>\n      <li>A renda do restaurante.</li>\n      <li>Saldo do cartão de crédito e das parcelas que faltam.</li>\n      <li>Saldo da reserva de emergência e dos outros caixas.</li>\n      <li>Investimentos: as carteiras Barsi, Bazin, Buffett e FIIs estão criadas, mas vazias.</li>\n    </ul>\n  </section>\n</div>\n\n<script>\nconst brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });\nconst brl0 = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });\nconst pct = new Intl.NumberFormat('pt-BR', { style: 'percent', maximumFractionDigits: 1 });\nconst MESES = ['jan','fev','mar','abr','mai','jun','jul','ago','set','out','nov','dez'];\nconst nomeMes = (m) => MESES[+m.slice(5, 7) - 1] + '/' + m.slice(0, 4);\nconst META = 7000;\nwindow.pfFmt = { brl, brl0, pct, nomeMes, META };\n\ndash.calc('mensal', {\n  inputs: ['contracheques'],\n  title: 'Renda por mês de recebimento',\n  description: 'Soma bruto, descontos e líquido de todos os contracheques que caíram em cada mês, e o líquido acumulado.',\n  fn: (contracheques) => {\n    const por = d3.rollups(contracheques, (v) => ({\n      bruto: d3.sum(v, (r) => +r.bruto),\n      descontos: d3.sum(v, (r) => +r.inss + +r.irrf + +r.outros_descontos),\n      liquido: d3.sum(v, (r) => +r.liquido),\n    }), (r) => r.mes_recebido).sort((a, b) => d3.ascending(a[0], b[0]));\n    let acc = 0;\n    return por.map(([mes, s]) => {\n      acc += s.liquido;\n      return { mes, bruto: Math.round(s.bruto * 100) / 100, descontos: Math.round(s.descontos * 100) / 100, liquido: Math.round(s.liquido * 100) / 100, acumulado: Math.round(acc * 100) / 100 };\n    });\n  },\n});\n\ndash.calc('resumo', {\n  inputs: ['mensal'],\n  title: 'Resumo do progresso',\n  description: 'Totais desde o primeiro mês, médias do começo e dos últimos 3 meses, e o último mês comparado à meta de R$ 7.000.',\n  fn: (mensal) => {\n    if (!mensal.length) return [];\n    const ult = mensal[mensal.length - 1];\n    const r2 = (x) => Math.round(x * 100) / 100;\n    return [{\n      total_liquido: r2(d3.sum(mensal, (m) => m.liquido)),\n      total_bruto: r2(d3.sum(mensal, (m) => m.bruto)),\n      total_descontos: r2(d3.sum(mensal, (m) => m.descontos)),\n      meses: mensal.length,\n      media_3m: r2(d3.mean(mensal.slice(-3), (m) => m.liquido)),\n      media_inicio: r2(d3.mean(mensal.slice(0, 3), (m) => m.liquido)),\n      ultimo_mes: ult.mes,\n      ultimo_liquido: ult.liquido,\n      pct_meta: Math.round((ult.liquido / 7000) * 1000) / 1000,\n      falta_meta: r2(Math.max(0, 7000 - ult.liquido)),\n    }];\n  },\n});\n</script>\n\n<script>\nconst { brl, brl0, pct, nomeMes, META } = window.pfFmt;\nconst fmtCampo = {\n  total_liquido: brl.format, total_bruto: brl.format, total_descontos: brl.format,\n  media_3m: brl.format, media_inicio: brl.format, ultimo_liquido: brl.format, falta_meta: brl.format,\n  pct_meta: pct.format, meses: String, ultimo_mes: nomeMes,\n};\n\nfunction erro(el) {\n  el.textContent = '';\n  const d = document.createElement('div'); d.className = 'pf-erro';\n  const i = document.createElement('i'); const s = document.createElement('span'); s.textContent = 'Não carregou';\n  d.append(i, s); el.append(d);\n}\n\nfunction tooltip(box, html, x, y) {\n  let t = box.querySelector('.pf-tip');\n  if (!t) { t = document.createElement('div'); t.className = 'pf-tip'; box.append(t); }\n  t.textContent = '';\n  const a = document.createElement('div'); a.className = 'd'; a.textContent = html[0];\n  const b = document.createElement('div'); b.textContent = html[1];\n  t.append(a, b);\n  t.style.display = 'block';\n  const w = t.offsetWidth, W = box.clientWidth;\n  t.style.left = Math.max(0, Math.min(W - w, x - w / 2)) + 'px';\n  t.style.top = Math.max(0, y - t.offsetHeight - 8) + 'px';\n}\nconst esconder = (box) => { const t = box.querySelector('.pf-tip'); if (t) t.style.display = 'none'; };\n\nfunction eixoY(svg, y, w, m) {\n  const g = svg.append('g');\n  y.ticks(4).forEach((v) => {\n    g.append('line').attr('x1', m.l).attr('x2', w - m.r).attr('y1', y(v)).attr('y2', y(v)).attr('stroke', 'var(--cds-chart-grid)');\n    g.append('text').attr('x', m.l - 6).attr('y', y(v)).attr('dy', '0.32em').attr('text-anchor', 'end')\n      .attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)').text(brl0.format(v));\n  });\n}\n\nfunction medirMargem(svg, y) {\n  const t = svg.append('text').style('font-size', 'var(--cds-font-size-caption)').text(brl0.format(d3.max(y.ticks(4))));\n  const w = t.node().getComputedTextLength(); t.remove(); return Math.ceil(w) + 10;\n}\n\nfunction eixoX(svg, dados, xpos, h, m, w) {\n  const passo = Math.max(1, Math.ceil(dados.length / Math.max(2, Math.floor((w - m.l - m.r) / 56))));\n  dados.forEach((d, i) => {\n    if (i % passo && i !== dados.length - 1) return;\n    if (i !== dados.length - 1 && dados.length - 1 - i < passo) return;\n    const t = svg.append('text').attr('y', h - m.b + 16).attr('text-anchor', 'start')\n      .attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)').text(nomeMes(d.mes));\n    const tw = t.node().getComputedTextLength();\n    t.attr('x', Math.max(m.l, Math.min(w - tw - 1, xpos(d) - tw / 2)));\n  });\n}\n\nfunction graficoMensal(box, dados) {\n  box.textContent = '';\n  const w = box.clientWidth, h = 240, m = { t: 12, r: 8, b: 26, l: 0 };\n  const y = d3.scaleLinear([0, Math.max(META, d3.max(dados, (d) => d.liquido)) * 1.08], [h - m.b, m.t]).nice();\n  const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n  m.l = medirMargem(svg, y);\n  const x = d3.scaleBand(dados.map((d) => d.mes), [m.l, w - m.r]).padding(0.25);\n  eixoY(svg, y, w, m);\n  const bars = svg.append('g').selectAll('rect').data(dados).join('rect')\n    .attr('x', (d) => x(d.mes)).attr('width', Math.min(32, x.bandwidth()))\n    .attr('transform', x.bandwidth() > 32 ? `translate(${(x.bandwidth() - 32) / 2},0)` : null)\n    .attr('y', (d) => y(d.liquido)).attr('height', (d) => y(0) - y(d.liquido)).attr('rx', 4)\n    .attr('fill', dash.colors[0]).attr('opacity', 0.85);\n  svg.append('line').attr('x1', m.l).attr('x2', w - m.r).attr('y1', y(META)).attr('y2', y(META))\n    .attr('stroke', 'var(--cds-chart-reference)').attr('stroke-dasharray', '5 4');\n  svg.append('text').attr('x', w - m.r).attr('y', y(META) - 6).attr('text-anchor', 'end')\n    .attr('fill', 'var(--color-fg-muted)').style('font-size', 'var(--cds-font-size-caption)').text('Meta R$ 7.000');\n  eixoX(svg, dados, (d) => x(d.mes) + x.bandwidth() / 2, h, m, w);\n  svg.append('g').selectAll('rect').data(dados).join('rect')\n    .attr('x', (d) => x(d.mes) - (x.step() - x.bandwidth()) / 2).attr('width', x.step()).attr('y', m.t).attr('height', h - m.t - m.b)\n    .attr('fill', 'transparent')\n    .on('mousemove', (ev, d) => {\n      bars.attr('opacity', (b) => (b === d ? 1 : 0.45));\n      const s = box.clientWidth / w;\n      tooltip(box, [nomeMes(d.mes), 'Líquido ' + brl.format(d.liquido)], (x(d.mes) + x.bandwidth() / 2) * s, y(d.liquido) * s);\n    })\n    .on('mouseleave', () => { bars.attr('opacity', 0.85); esconder(box); });\n}\n\nfunction graficoAcum(box, dados) {\n  box.textContent = '';\n  const w = box.clientWidth, h = 240, m = { t: 12, r: 8, b: 26, l: 0 };\n  const y = d3.scaleLinear([0, d3.max(dados, (d) => d.acumulado) * 1.05], [h - m.b, m.t]).nice();\n  const svg = d3.select(box).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${w} ${h}`);\n  m.l = medirMargem(svg, y);\n  const x = d3.scalePoint(dados.map((d) => d.mes), [m.l + 6, w - m.r - 6]);\n  eixoY(svg, y, w, m);\n  const id = 'pf-grad';\n  const grad = svg.append('defs').append('linearGradient').attr('id', id).attr('x1', 0).attr('x2', 0).attr('y1', 0).attr('y2', 1);\n  [[0, .26], [.25, .16], [.5, .08], [.75, .03], [1, 0]].forEach(([o, a]) => grad.append('stop').attr('offset', o).attr('style', `stop-color:${dash.colors[0]};stop-opacity:${a}`));\n  svg.append('path').datum(dados).attr('fill', `url(#${id})`)\n    .attr('d', d3.area().x((d) => x(d.mes)).y0(y(0)).y1((d) => y(d.acumulado)));\n  svg.append('path').datum(dados).attr('fill', 'none').attr('stroke', dash.colors[0]).attr('stroke-width', 2)\n    .attr('stroke-linecap', 'round').attr('stroke-linejoin', 'round')\n    .attr('d', d3.line().x((d) => x(d.mes)).y((d) => y(d.acumulado)));\n  eixoX(svg, dados, (d) => x(d.mes), h, m, w);\n  const dot = svg.append('circle').attr('r', 4).attr('fill', dash.colors[0]).style('display', 'none');\n  const pts = dados.map((d) => [x(d.mes), y(d.acumulado)]);\n  const del = d3.Delaunay.from(pts.map((p) => [p[0], 0]));\n  svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', w - m.l - m.r).attr('height', h - m.t - m.b).attr('fill', 'transparent')\n    .on('mousemove', (ev) => {\n      const [px] = d3.pointer(ev); const i = del.find(px, 0); const d = dados[i];\n      dot.style('display', null).attr('cx', pts[i][0]).attr('cy', pts[i][1]);\n      const s = box.clientWidth / w;\n      tooltip(box, [nomeMes(d.mes), 'Acumulado ' + brl.format(d.acumulado)], pts[i][0] * s, pts[i][1] * s);\n    })\n    .on('mouseleave', () => { dot.style('display', 'none'); esconder(box); });\n}\n\nfunction tabela(tb, dados) {\n  tb.textContent = '';\n  [...dados].reverse().forEach((d) => {\n    const tr = document.createElement('tr'); tr.dataset.key = d.mes;\n    [nomeMes(d.mes), brl.format(d.bruto), brl.format(d.descontos), brl.format(d.liquido), brl.format(d.acumulado)].forEach((t) => {\n      const td = document.createElement('td'); td.textContent = t; tr.append(td);\n    });\n    tb.append(tr);\n  });\n}\n\ndash.onData(() => {\n  const r = dash.data('resumo'), m = dash.data('mensal');\n  document.querySelectorAll('[data-source=\"resumo\"]').forEach((el) => {\n    if (r.status === 'ok' && r.data.length) {\n      el.classList.remove('dash-skeleton');\n      el.textContent = (fmtCampo[el.dataset.field] || String)(r.data[0][el.dataset.field]);\n    } else {\n      el.textContent = '—';\n      if (r.status !== 'loading') el.classList.remove('dash-skeleton');\n    }\n  });\n  const g1 = document.getElementById('g-mensal'), g2 = document.getElementById('g-acum');\n  const tb = document.querySelector('.pf-tab tbody');\n  if (m.status === 'ok' && m.data.length) {\n    graficoMensal(g1, m.data); graficoAcum(g2, m.data); tabela(tb, m.data);\n  } else {\n    tb.textContent = '';\n    if (m.status === 'error') { erro(g1); erro(g2); }\n    else { g1.textContent = ''; g2.textContent = ''; }\n  }\n});\n</script>\n"
}
