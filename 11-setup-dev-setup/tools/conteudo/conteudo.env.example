# Configuração do pipeline de conteúdo. Fica em ~/.config/amtech/conteudo.env (fora do repositório).
# A chave da API é diferente da assinatura do Claude: é cobrada por uso em console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pastas (padrão: ~/AMtech)
# AMTECH_DIR=/home/seu-usuario/AMtech

# Guia de marca usado em todas as peças (padrão: config/marca.md do repositório)
# GUIA_MARCA=/home/seu-usuario/dev/dev-setup/config/marca.md

# Transcrição local de áudio e vídeo (instale com: bash scripts/wsl/bootstrap.sh --com-whisper)
TRANSCRITOR_CMD=whisper-ctranslate2 --language pt --model small --output_format txt --output_dir {saida} {arquivo}

# Aviso no celular quando houver peças para aprovar (opcional). Crie o bot com o @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
