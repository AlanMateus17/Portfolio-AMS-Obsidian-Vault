# Ghostty: terminal do Arch nativo (2º NVMe). No Windows o terminal segue sendo o Windows Terminal.
font-size = 12
theme = dark:catppuccin-mocha,light:catppuccin-latte
window-padding-x = 8
window-padding-y = 6
copy-on-select = clipboard
confirm-close-surface = false
shell-integration = bash
command = zellij attach --create principal
