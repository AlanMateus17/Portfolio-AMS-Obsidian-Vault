// zellij --layout setup: código à esquerda, servidor e git à direita, aba de serviços.
layout {
    default_tab_template {
        pane size=1 borderless=true { plugin location="zellij:tab-bar"; }
        children
        pane size=2 borderless=true { plugin location="zellij:status-bar"; }
    }
    tab name="código" focus=true {
        pane split_direction="vertical" {
            pane size="60%" name="editor"
            pane split_direction="horizontal" {
                pane name="servidor"
                pane name="git" command="lazygit"
            }
        }
    }
    tab name="serviços" {
        pane name="containers" command="lazydocker"
        pane name="monitor" command="btop"
    }
}
