# Copie para .env (cp -n jarvis.env.example .env). O .env não vai para o Git.
# Pasta dos dados do Jarvis (modelos de voz, MQTT, Zigbee, Frigate).
JARVIS_DIR=/home/alanmateus/jarvis
# 127.0.0.1 = só este computador. No servidor da casa, use o IP fixo dele na rede de casa (ex.: 192.168.0.10),
# nunca 0.0.0.0 num computador que sai de casa (notebook na escola).
JARVIS_IP=127.0.0.1
# small (rápido) ou medium (mais preciso, perto do limite dos 4 GB da GTX 1650).
WHISPER_MODELO=small
PIPER_VOZ=pt_BR-faber-medium
# Coordenador Zigbee (ls /dev/serial/by-id/ mostra o nome certo).
ZIGBEE_USB=/dev/ttyUSB0
# Senha das câmeras (vem do KeePassXC) e onde ficam as gravações (disco grande, de preferência HD de vigilância).
FRIGATE_RTSP_SENHA=
FRIGATE_GRAVACOES=/srv/frigate
