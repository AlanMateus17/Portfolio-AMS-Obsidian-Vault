# Copie para .env (que o Git ignora) e rode: bash gerar-senhas.sh
# As senhas ficam só neste arquivo e no seu KeePassXC. Nunca no repositório.

# Pasta das entradas e saídas do pipeline de conteúdo (no WSL)
AMTECH_DIR=/home/SEU_USUARIO/AMtech

# Preenchidos pelo gerar-senhas.sh
METRICAS_SENHA=
GRAFANA_DB_SENHA=
GRAFANA_SENHA=
N8N_CHAVE=

# Endereço público dos webhooks (preencha quando o túnel existir; ex.: https://n8n.seu-dominio.com.br/)
N8N_WEBHOOK_URL=http://localhost:5678/

# Versões das imagens. Depois que tudo funcionar, troque "latest" pela versão em uso para não mudar sozinho.
N8N_VERSAO=latest
GRAFANA_VERSAO=latest
KUMA_VERSAO=1
