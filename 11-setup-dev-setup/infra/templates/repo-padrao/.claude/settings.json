{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./.kamal/secrets*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/*.kdbx)",
      "Read(./node_modules/**)",
      "Read(./**/bin/**)",
      "Read(./**/obj/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./**/*.log)",
      "Read(./package-lock.json)",
      "Read(./pnpm-lock.yaml)",
      "Read(~/.ssh/**)"
    ]
  }
}
