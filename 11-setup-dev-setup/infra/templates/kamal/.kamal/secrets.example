# Copie para .kamal/secrets (que fica no .gitignore). Nenhum valor é escrito aqui:
# cada linha pede o segredo ao KeePassXC na hora do deploy (ele pergunta a senha do cofre).
# Rode no Ubuntu do WSL. O caminho do cofre é o seu; as entradas ficam no grupo AMtech/Deploy.
COFRE=$HOME/Cofre/AMtech.kdbx
KAMAL_REGISTRY_PASSWORD=$(keepassxc-cli show -sa password "$COFRE" "AMtech/Deploy/GHCR token")
POSTGRES_PASSWORD=$(keepassxc-cli show -sa password "$COFRE" "AMtech/Deploy/<am-sistema> postgres")
ConnectionStrings__Principal="Host=<am-sistema>-db;Database=<am-sistema>;Username=postgres;Password=$POSTGRES_PASSWORD"
