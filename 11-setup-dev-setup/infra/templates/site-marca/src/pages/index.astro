---
import Base from "../layouts/Base.astro";
import marca from "../marca.json";
const c = marca.contato;
const whats = c.whatsapp ? `https://wa.me/${c.whatsapp.replace(/\D/g, "")}?text=${encodeURIComponent(c.whatsapp_mensagem ?? "Olá! Vim pelo site.")}` : null;
const acaoPrincipal = c.formulario || whats || (c.email ? `mailto:${c.email}` : "#contato");
---
<Base>
  <section class="w" style="padding-top:48px;padding-bottom:56px"><div class="estreito" style="max-width:860px;gap:22px">
    <span class="rotulo">{marca.chamada}</span>
    <h1>{marca.titulo}</h1>
    <p class="suave" style="font-size:19px;max-width:62ch">{marca.subtitulo}</p>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:6px">
      <a class="btn cheio" href={acaoPrincipal}>{marca.acao_principal}</a>
      <a class="btn vazio" href="#ofertas">Ver {marca.secoes.ofertas.toLowerCase()}</a>
    </div>
  </div></section>

  <section id="ofertas" class="w" style="padding-top:24px">
    <span class="rotulo">{marca.secoes.ofertas}</span>
    <h2 style="margin-top:8px">{marca.secoes.ofertas_titulo}</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;margin-top:26px">
      {marca.ofertas.map((o) => (
        <article style="background:var(--c-sup);border:1px solid var(--c-linha);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <h3 style="font-size:23px">{o.nome}</h3>
          <p class="suave">{o.resumo}</p>
          <ul style="margin:4px 0 0;padding-left:20px;display:grid;gap:4px">
            {o.inclui.map((i) => <li>{i}</li>)}
          </ul>
          <p style="margin-top:auto;padding-top:10px;font-weight:700;font-size:20px">{o.preco || marca.texto_sem_preco || "Sob orçamento"}{o.prazo && <span class="suave" style="font-weight:400;font-size:15px"> · {o.prazo}</span>}</p>
          <a class="btn vazio" style="justify-content:center" href={o.link || acaoPrincipal}>{o.acao || marca.acao_principal}</a>
        </article>
      ))}
    </div>
  </section>

  <section id="como" class="w" style="padding-top:72px">
    <span class="rotulo">Como funciona</span>
    <h2 style="margin-top:8px">{marca.secoes.como_titulo}</h2>
    <ol style="list-style:none;padding:0;margin:26px 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px">
      {marca.passos.map((p, i) => (
        <li style="border-top:3px solid var(--c-dest);padding-top:14px;display:grid;gap:6px;align-content:start">
          <span style="font:700 28px Georgia,serif;color:var(--c-dest)">{i + 1}</span>
          <strong>{p.titulo}</strong>
          <span class="suave">{p.texto}</span>
        </li>
      ))}
    </ol>
  </section>

  <section id="sobre" class="w" style="padding-top:72px"><div class="estreito">
    <span class="rotulo">Sobre</span>
    <h2>{marca.sobre.titulo}</h2>
    {marca.sobre.paragrafos.map((p) => <p>{p}</p>)}
  </div></section>

  {marca.perguntas?.length > 0 && (
    <section class="w" style="padding-top:72px"><div class="estreito">
      <span class="rotulo">Dúvidas</span>
      <h2 style="margin-top:8px">Perguntas frequentes</h2>
      <div style="margin-top:20px;display:grid;gap:10px">
        {marca.perguntas.map((q) => (
          <details style="background:var(--c-sup);border:1px solid var(--c-linha);border-radius:12px;padding:14px 18px">
            <summary style="cursor:pointer;font-weight:600">{q.p}</summary>
            <p class="suave" style="margin-top:10px">{q.r}</p>
          </details>
        ))}
      </div>
    </div></section>
  )}

  <section id="contato" class="w" style="padding-top:72px">
    <div style="background:var(--c-pri);color:var(--c-sobre);border-radius:20px;padding:clamp(24px,5vw,48px);display:grid;gap:14px">
      <h2>{marca.contato.titulo}</h2>
      <p style="max-width:60ch;opacity:.9">{marca.contato.texto}</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:6px">
        {c.formulario && <a class="btn" style="background:var(--c-sobre);color:var(--c-pri);border-color:var(--c-sobre)" href={c.formulario}>{marca.acao_principal}</a>}
        {whats && <a class="btn" style="color:var(--c-sobre);border-color:var(--c-sobre)" href={whats}>WhatsApp</a>}
        {c.email && <a class="btn" style="color:var(--c-sobre);border-color:var(--c-sobre)" href={`mailto:${c.email}`}>{c.email}</a>}
      </div>
    </div>
  </section>
</Base>
