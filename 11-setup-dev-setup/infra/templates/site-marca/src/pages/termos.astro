---
import Base from "../layouts/Base.astro";
import marca from "../marca.json";
const l = marca.legal;
---
<Base titulo="Termos de uso" descricao={`Termos de uso de ${marca.nome}.`}>
  <article class="w" style="padding-top:32px"><div class="estreito">
    <span class="rotulo">Termos</span>
    <h1 style="font-size:clamp(30px,5vw,44px)">Termos de uso</h1>
    <p class="suave">Atualizados em {l.atualizado}. Modelo do dev-setup: revise com um advogado.</p>
    {l.termos.map((t) => (<><h2 style="font-size:24px;margin-top:12px">{t.titulo}</h2><p>{t.texto}</p></>))}
    <h2 style="font-size:24px;margin-top:12px">Contato</h2>
    <p><a href={`mailto:${l.email_privacidade}`}>{l.email_privacidade}</a></p>
  </div></article>
</Base>
